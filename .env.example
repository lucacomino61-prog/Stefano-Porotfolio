# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres connection string.
DATABASE_URL=

# Resend transactional email.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Upstash Redis, used for per-IP rate limiting.
# Optional in development (an in-memory limiter takes over).
# Required in production: the build refuses to start without it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin. Generate the hash with: npm run hash-password -- "your password"
ADMIN_PASSWORD_HASH=
# At least 32 characters. Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Salt for one-way visitor hashing in analytics and rate limiting.
IP_HASH_SALT=

# Absolute site origin, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact address, shown in the footer and the no-JavaScript fallback.
# Optional: both are omitted when unset.
NEXT_PUBLIC_CONTACT_EMAIL=
